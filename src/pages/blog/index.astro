---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

// Índice automático del blog: añade un objeto por cada artículo.
// Si cambias el título de un artículo, actualízalo también aquí.
// Las rutas se escriben sin la barra inicial: se les añade BASE_URL al renderizar.
const articulos = [
  {
    title: 'Curos de Word',
    href: 'blog/articulo-1/',
    description: 'Curos basicos y nivel avanzado de Word',
  },
  {
    title: 'Curo,
    href: 'blog/articulo-2/',
    description: 'Cursos basicos y nivel avanzado de Excel',
  },
];
---

<BaseLayout title="Blog | Tecniform" description="Empresa de Formacion">
  <h1>TODO: título del blog</h1>

  <ul>
    {articulos.map((articulo) => (
      <li>
        <a href={`${base}${articulo.href}`}>{articulo.title}</a>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
